# Strava API application credentials.
# Create an app at https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# A random 32+ character string used to encrypt the session cookie.
# Generate one with: openssl rand -base64 32
SESSION_PASSWORD=

# The public base URL of the deployment (no trailing slash).
# Used to build the Strava OAuth redirect URI.
# Locally this is http://localhost:3000
# On Vercel set it to your deployment URL, e.g. https://strava-to-maps.vercel.app
APP_BASE_URL=http://localhost:3000
